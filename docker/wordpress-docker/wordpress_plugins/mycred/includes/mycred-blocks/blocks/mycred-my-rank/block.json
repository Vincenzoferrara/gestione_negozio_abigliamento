{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mycred-gb-blocks/mycred-my-rank",
  "title": "My Rank",
  "category": "mycred",
  "icon": "awards",
  "description": "Display the rank of a user based on the selected point type.",
  "attributes": {
    "user_id": {
      "type": "string"
    },
    "show_title": {
      "type": "boolean",
      "default": true
    },
    "show_logo": {
      "type": "boolean"
    },
    "logo_size": {
      "type": "string",
      "default": "post-thumbnail"
    },
    "first": {
      "type": "string",
      "default": "logo"
    },
    "ctype": {
      "type": "string"
    }
  },
  "textdomain": "mycred",
  "editorScript": "mycred-my-rank",
  "render": "php:MG_Blocks\\mycred_my_rank_block::render_block"
}
