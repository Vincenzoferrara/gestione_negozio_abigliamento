+    private function enforce_rate_limit($scope, $max_attempts = 10, $window_seconds = 60) {
+        $user_id = (int) get_current_user_id();
+        if ($user_id <= 0) {
+            return true;
+        }
+        $key = 'mgws_rl_' . md5($scope . ':' . $user_id);
+        $count = (int) get_transient($key);
+        if ($count >= $max_attempts) {
+            return new WP_Error('mgws_rate_limited', 'Too many requests, retry later', array('status' => 429));
+        }
+        set_transient($key, $count + 1, $window_seconds);
+        return true;
+    }
+
+    private function audit_security_event($action, $target_user_id, $extra = array()) {
+        $payload = array(
+            'source' => 'mgws-security',
+            'action' => (string) $action,
+            'actor_user_id' => (int) get_current_user_id(),
+            'target_user_id' => (int) $target_user_id,
+            'ip' => isset($_SERVER['REMOTE_ADDR']) ? sanitize_text_field((string) $_SERVER['REMOTE_ADDR']) : '',
+            'ua' => isset($_SERVER['HTTP_USER_AGENT']) ? sanitize_text_field((string) $_SERVER['HTTP_USER_AGENT']) : '',
+            'extra' => $extra,
+        );
+        if (function_exists('wc_get_logger')) {
+            wc_get_logger()->notice(wp_json_encode($payload), array('source' => 'mgws-security'));
+            return;
+        }
+        error_log('MGWS SECURITY ' . wp_json_encode($payload));
+    }
